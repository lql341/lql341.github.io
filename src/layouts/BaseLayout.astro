---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'zh';
  headerVariant?: 'default' | 'home';
  bodyClass?: string;
}
const { title, description, lang = 'en', headerVariant = 'default', bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = bodyClass === 'home-page';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="opensource_community" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <div class="shell">
      <Header lang={lang} variant={headerVariant} />
      <main><slot /></main>
      <Footer />
    </div>
    <script is:inline define:vars={{ isHome }}>
      const languagePreferenceKey = 'site-language-preference';
      const languageSwitch = document.querySelector('[data-language-switch]');

      languageSwitch?.addEventListener('click', () => {
        try {
          localStorage.setItem(languagePreferenceKey, languageSwitch.dataset.languageSwitch);
        } catch (_) {}
      });

      if (isHome) {
        try {
          const saved = localStorage.getItem(languagePreferenceKey);
          const browserLanguage = (navigator.language || '').toLowerCase();
          const isChineseBrowser = browserLanguage.startsWith('zh');
          const path = window.location.pathname;

          if (saved === 'zh' && path === '/') {
            window.location.replace('/zh/');
          } else if (saved === 'en' && path.startsWith('/zh')) {
            window.location.replace('/');
          } else if (!saved && isChineseBrowser && path === '/') {
            window.location.replace('/zh/');
          }
        } catch (_) {}
      }
    </script>
  </body>
</html>
