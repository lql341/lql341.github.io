---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.homeOrder - b.data.homeOrder);
---
<BaseLayout
  title="opensource_community · Open Systems, Accelerated"
  description="Open-source accelerated systems engineering and reproducible performance research."
  headerVariant="home"
  bodyClass="home-page"
>
  <section class="minimal-hero">
    <div class="hero-copy">
      <div class="overline">Accelerated systems engineering</div>
      <h1>Open systems,<br /><span>accelerated.</span></h1>
      <p class="intro">GPU software adaptation and performance research, published with reproducible evidence.</p>
      <a class="scroll-link" href="#work">Selected work <b aria-hidden="true">↓</b></a>
    </div>
    <aside class="profile">
      <strong>Research focus</strong><br />
      HPC · GPU runtimes<br />
      ABI · profiling<br />
      Open-source systems
    </aside>
    <div class="signal-line" aria-hidden="true"></div>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="work-head">
      <div><div class="overline">Selected work</div><h2 id="work-title">Research index</h2></div>
      <span>PUBLIC NOTES / 2026</span>
    </div>

    <div class="index">
      {reports.map(({ data }, index) => (
        <a class="work-row" href={data.href}>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <div class="work-title">
            <h3>{data.titleEn}</h3>
            <p>{data.tags.join(' · ')}</p>
          </div>
          <div class="result"><strong>{data.metric ?? '—'}</strong><span>{data.metricLabel ?? data.summary}</span></div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="open-source" aria-labelledby="open-source-title">
    <div class="open-source-head">
      <div><div class="overline">Open-source systems</div><h2 id="open-source-title">From field notes<br />to reusable tools.</h2></div>
      <p>Operational knowledge for domestic supercomputing clusters, turned into installable agent tooling and ecosystem integrations.</p>
    </div>
    <div class="project-links">
      <a class="project-link project-primary" href="https://github.com/lql341/scnet-hpc" target="_blank" rel="noreferrer">
        <span class="project-kind">Original · Core</span><h3>scnet-hpc</h3><p>Agent skill and automation for SSH, Slurm, Hygon DCU/DTK, and cluster troubleshooting.</p><b>GitHub ↗</b>
      </a>
      <a class="project-link" href="https://github.com/lql341/dsh-scnet" target="_blank" rel="noreferrer">
        <span class="project-kind">Original · Integration</span><h3>dsh-scnet</h3><p>DeepSeek Harness packaging for the shared SCNet knowledge and tools.</p><b>GitHub ↗</b>
      </a>
      <a class="project-link collaboration-link" href="https://github.com/eric2003/OneFLOW" target="_blank" rel="noreferrer">
        <span class="project-kind">Collaborative · Contributor</span><h3>OneFLOW</h3><p>Open-source multiphysics scientific simulation and CFD.</p><b>Upstream ↗</b>
      </a>
    </div>
    <a class="all-projects" href="/projects/">Explore the full project portfolio <span aria-hidden="true">→</span></a>
  </section>

  <section class="principle">
    <h2>Build.<br />Measure.<br /><span>Explain.</span></h2>
    <p>Every result is tied to a stated environment, workload, method, and boundary.</p>
  </section>

  <section class="contact" aria-labelledby="contact-title">
    <div><small>Research &amp; collaboration</small><h2 id="contact-title">Compare notes.</h2></div>
    <a class="email" href="mailto:luqilinheu@gmail.com">luqilinheu@gmail.com ↗</a>
  </section>
</BaseLayout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.starfield');
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let lastFrameAt = 0;
    let nextMeteorAt = performance.now() + 1800;
    let meteor: { startedAt: number; x: number; y: number; dx: number; dy: number } | null = null;
    let stars: { x: number; y: number; radius: number; phase: number; color: string; vx: number; vy: number }[] = [];
    let animationFrame = 0;

    const resize = () => {
      window.cancelAnimationFrame(animationFrame);
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context!.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

      const count = Math.max(90, Math.round((width * height) / 5600));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 1.45 + 0.4,
        phase: Math.random() * Math.PI * 2,
        color: Math.random() > 0.82 ? '155,234,52' : Math.random() > 0.5 ? '178,220,255' : '232,242,255',
        vx: (Math.random() - 0.5) * 0.62,
        vy: (Math.random() - 0.5) * 0.44,
      }));
      lastFrameAt = 0;
      draw(performance.now());
    };

    const draw = (time: number) => {
      context!.clearRect(0, 0, width, height);
      const delta = lastFrameAt ? Math.min(time - lastFrameAt, 50) / 1000 : 0;
      lastFrameAt = time;

      if (!reducedMotion.matches) {
        stars.forEach((star) => {
          star.x = (star.x + star.vx * delta + width) % width;
          star.y = (star.y + star.vy * delta + height) % height;
        });
      }

      // Connect only nearby stars to form sparse, quiet constellations.
      for (let i = 0; i < stars.length; i += 1) {
        const a = stars[i];
        for (let j = i + 1; j < stars.length; j += 1) {
          const b = stars[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distance = Math.hypot(dx, dy);
          if (distance < 92) {
            context!.strokeStyle = `rgba(171, 205, 224, ${(1 - distance / 92) * 0.16})`;
            context!.lineWidth = 0.6;
            context!.beginPath();
            context!.moveTo(a.x, a.y);
            context!.lineTo(b.x, b.y);
            context!.stroke();
          }
        }
      }

      stars.forEach((star) => {
        const twinkle = reducedMotion.matches ? 0.68 : 0.52 + Math.sin(time * 0.0011 + star.phase) * 0.36;
        context!.beginPath();
        context!.fillStyle = `rgba(${star.color}, ${twinkle})`;
        context!.shadowColor = `rgba(${star.color}, ${twinkle * 0.55})`;
        context!.shadowBlur = star.radius * 5;
        context!.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        context!.fill();
      });
      context!.shadowBlur = 0;

      if (!reducedMotion.matches) {
        if (!meteor && time >= nextMeteorAt) {
          meteor = {
            startedAt: time,
            x: width * (0.58 + Math.random() * 0.36),
            y: height * (0.08 + Math.random() * 0.3),
            dx: -Math.min(250, width * 0.28),
            dy: Math.min(145, height * 0.22),
          };
          nextMeteorAt = time + 5200 + Math.random() * 4200;
        }

        if (meteor) {
          const progress = Math.min((time - meteor.startedAt) / 900, 1);
          const x = meteor.x + meteor.dx * progress;
          const y = meteor.y + meteor.dy * progress;
          const trail = context!.createLinearGradient(x - meteor.dx * 0.42, y - meteor.dy * 0.42, x, y);
          trail.addColorStop(0, 'rgba(155,234,52,0)');
          trail.addColorStop(1, 'rgba(218,246,255,0.96)');
          context!.strokeStyle = trail;
          context!.lineWidth = 1.7;
          context!.beginPath();
          context!.moveTo(x - meteor.dx * 0.42, y - meteor.dy * 0.42);
          context!.lineTo(x, y);
          context!.stroke();
          context!.beginPath();
          context!.fillStyle = 'rgba(236,250,255,0.95)';
          context!.shadowColor = 'rgba(155,234,52,0.9)';
          context!.shadowBlur = 12;
          context!.arc(x, y, 2, 0, Math.PI * 2);
          context!.fill();
          context!.shadowBlur = 0;
          if (progress >= 1) meteor = null;
        }
      }

      if (!reducedMotion.matches) animationFrame = window.requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    reducedMotion.addEventListener('change', () => {
      window.cancelAnimationFrame(animationFrame);
      if (!reducedMotion.matches) nextMeteorAt = performance.now() + 1200;
      draw(performance.now());
    });
  }
</script>

<style>
  .minimal-hero { position: relative; isolation: isolate; min-height: 540px; display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 64px; align-items: end; padding: 74px 0 54px; overflow: hidden; }
  .minimal-hero::before { position: absolute; z-index: -1; inset: -8% -8% 2% 36%; content: ""; pointer-events: none; background: radial-gradient(ellipse at 68% 40%, rgba(45,91,121,.16), transparent 55%), radial-gradient(ellipse at 76% 34%, rgba(155,234,52,.08), transparent 42%); }
  .starfield { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero-copy, .profile, .signal-line { position: relative; z-index: 1; }
  .overline { color: var(--accent); font: 700 10px/1.4 monospace; letter-spacing: .18em; text-transform: uppercase; }
  .minimal-hero h1 { max-width: 900px; margin: 20px 0 24px; font-size: clamp(58px, 8vw, 112px); font-weight: 610; line-height: .88; letter-spacing: -.075em; }
  .minimal-hero h1 span { color: var(--muted); }
  .intro { max-width: 620px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.65; }
  .scroll-link { display: inline-flex; gap: 10px; margin-top: 34px; color: var(--text); font-size: 13px; font-weight: 700; text-decoration: none; }
  .scroll-link b { color: var(--accent); font-size: 17px; }
  .profile { align-self: end; padding-bottom: 4px; color: var(--muted); font: 11px/1.8 monospace; text-transform: uppercase; letter-spacing: .08em; }
  .profile::before { content: ""; display: block; width: 100%; height: 1px; margin-bottom: 22px; background: var(--line); }
  .profile strong { color: var(--text); font-weight: 600; }
  .signal-line { grid-column: 1 / -1; height: 1px; margin-top: 30px; background: linear-gradient(90deg, var(--accent), rgba(155,234,52,.1) 54%, transparent); box-shadow: -40px 0 38px rgba(155,234,52,.22); }

  .work { padding: 82px 0 96px; }
  .work-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 30px; }
  .work-head h2 { margin: 10px 0 0; font-size: clamp(36px, 4vw, 54px); font-weight: 600; letter-spacing: -.055em; }
  .work-head > span { color: #5b645d; font: 10px/1.4 monospace; letter-spacing: .12em; }
  .index { border-top: 1px solid var(--line); }
  .work-row { display: grid; grid-template-columns: 42px minmax(0, 1fr) 210px 30px; gap: 22px; align-items: center; min-height: 0; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding .25s ease, color .25s ease; }
  .work-row:hover { padding-left: 14px; color: var(--accent); }
  .number { align-self: start; padding-top: 10px; color: #5b645d; font: 11px/1 monospace; }
  .work-title h3 { margin: 0; max-width: 760px; font-size: clamp(22px, 2.45vw, 34px); font-weight: 560; line-height: 1.12; letter-spacing: -.045em; }
  .work-title p { margin: 9px 0 0; color: var(--muted); font-size: 13px; }
  .result { color: var(--muted); }
  .result strong { display: block; margin-bottom: 6px; color: var(--text); font-size: 23px; font-weight: 600; letter-spacing: -.045em; }
  .result span { font: 10px/1.5 monospace; letter-spacing: .06em; text-transform: uppercase; }
  .arrow { color: var(--accent); font-size: 24px; }

  .open-source { padding: 92px 0 104px; border-top: 1px solid var(--line); }
  .open-source-head { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 70px; align-items: end; margin-bottom: 46px; }
  .open-source-head h2 { margin: 12px 0 0; font-size: clamp(42px, 6vw, 76px); font-weight: 600; line-height: 1; letter-spacing: -.06em; }
  .open-source-head > p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .project-links { display: grid; grid-template-columns: 1.15fr 1fr 1fr; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .project-link { min-height: 300px; display: flex; flex-direction: column; padding: clamp(26px, 3.5vw, 42px); text-decoration: none; background: rgba(10,13,10,.72); transition: background .2s ease; }
  .project-link + .project-link { border-left: 1px solid var(--line); }
  .project-link:hover { background: rgba(155,234,52,.045); }
  .project-primary { background: linear-gradient(145deg, rgba(22,31,17,.96), rgba(10,13,10,.8)); }
  .project-kind { color: var(--accent); font: 700 10px/1.4 monospace; letter-spacing: .12em; text-transform: uppercase; }
  .project-link h3 { margin: 32px 0 14px; font-size: clamp(28px, 3.4vw, 43px); letter-spacing: -.05em; }
  .project-link p { margin: 0 0 28px; color: var(--muted); line-height: 1.7; }
  .project-link b { margin-top: auto; color: var(--text); font-size: 12px; }
  .collaboration-link .project-kind { color: var(--muted); }
  .all-projects { display: flex; justify-content: space-between; gap: 20px; margin-top: 22px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; font-weight: 700; text-decoration: none; }
  .all-projects span { color: var(--accent); font-size: 18px; }

  .principle { display: grid; grid-template-columns: minmax(0, 1fr) 270px; gap: 70px; align-items: end; padding: 86px 0; border-top: 1px solid var(--line); }
  .principle h2 { max-width: 970px; margin: 0; font-size: clamp(50px, 8vw, 112px); font-weight: 590; line-height: .93; letter-spacing: -.07em; }
  .principle h2 span { color: var(--accent); }
  .principle p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }

  .contact { position: relative; left: 50%; width: 100vw; margin-left: -50vw; display: flex; align-items: center; justify-content: space-between; gap: 50px; padding: 62px max(28px, calc((100vw - var(--max)) / 2)); color: #0a0d08; background: var(--accent); }
  .contact small { display: block; margin-bottom: 10px; font: 800 10px/1.4 monospace; letter-spacing: .16em; text-transform: uppercase; }
  .contact h2 { margin: 0; font-size: clamp(38px, 6vw, 76px); font-weight: 650; line-height: 1; letter-spacing: -.06em; }
  .email { padding-bottom: 5px; border-bottom: 1px solid rgba(10,13,8,.45); font-size: clamp(16px, 2vw, 22px); font-weight: 680; text-decoration: none; white-space: nowrap; }

  @media (max-width: 820px) {
    .minimal-hero { grid-template-columns: 1fr; gap: 55px; align-items: end; }
    .profile { max-width: 360px; }
    .signal-line { grid-column: 1; }
    .work-row { grid-template-columns: 38px minmax(0, 1fr) 30px; }
    .result { grid-column: 2; }
    .arrow { grid-column: 3; grid-row: 1 / 3; }
    .principle { grid-template-columns: 1fr; }
    .principle p { max-width: 500px; }
    .open-source-head { grid-template-columns: 1fr; gap: 28px; }
    .project-links { grid-template-columns: 1fr; }
    .project-link + .project-link { border-left: 0; border-top: 1px solid var(--line); }
    .project-link { min-height: 250px; }
    .contact { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 580px) {
    .minimal-hero { min-height: 650px; padding: 60px 0 42px; }
    .minimal-hero h1 { font-size: clamp(62px, 21vw, 98px); }
    .intro { font-size: 16px; }
    .work { padding: 70px 0 90px; }
    .work-head { align-items: flex-start; flex-direction: column; }
    .work-row { min-height: 0; gap: 15px; padding: 22px 0; }
    .work-title h3 { font-size: 29px; }
    .principle { padding: 82px 0; }
    .open-source { padding: 76px 0 88px; }
    .contact { padding-top: 70px; padding-bottom: 70px; }
    .email { white-space: normal; word-break: break-word; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row { transition: none; }
  }
</style>
