---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.homeOrder - b.data.homeOrder);
---
<BaseLayout
  lang="zh"
  title="opensource_community · 开源系统，异构加速"
  description="开源 GPU 软件适配、异构计算性能研究与可复现工程实践。"
  headerVariant="home"
  bodyClass="home-page"
>
  <section class="minimal-hero">
    <div>
      <div class="overline">异构系统工程</div>
      <h1>开源系统<br /><span>驱动异构加速</span></h1>
      <p class="intro">面向国产加速器的软件适配与性能研究，以可复现、可核验的工程证据呈现。</p>
      <a class="scroll-link" href="#work">查看精选成果 <b aria-hidden="true">↓</b></a>
    </div>
    <aside class="profile">
      <strong>研究方向</strong><br />
      高性能计算 · GPU 运行时<br />
      ABI 兼容 · 性能分析<br />
      开源系统工程
    </aside>
    <div class="signal-line" aria-hidden="true"></div>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="work-head">
      <div><div class="overline">精选工作</div><h2 id="work-title">研究档案</h2></div>
      <span>公开记录 / 2026</span>
    </div>

    <div class="index">
      {reports.map(({ data }, index) => (
        <a class="work-row" href={data.href}>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <div class="work-title">
            <h3>{data.title}</h3>
            <p>{(data.tagsZh ?? data.tags).join(' · ')}</p>
          </div>
          <div class="result"><strong>{data.metric ?? '—'}</strong><span>{data.metricLabel ?? data.summary}</span></div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="open-source" aria-labelledby="open-source-title">
    <div class="open-source-head">
      <div><div class="overline">开源系统工程</div><h2 id="open-source-title">从一线经验<br />到可复用工具</h2></div>
      <p>将国产超算集群上的实际操作知识，沉淀为可安装的智能体技能与生态集成。</p>
    </div>
    <div class="project-links">
      <a class="project-link project-primary" href="https://github.com/lql341/scnet-hpc" target="_blank" rel="noreferrer">
        <span class="project-kind">原创 · 核心项目</span><h3>scnet-hpc</h3><p>覆盖 SSH、Slurm、海光 DCU/DTK 与集群故障排查的智能体技能和自动化工具。</p><b>GitHub ↗</b>
      </a>
      <a class="project-link" href="https://github.com/lql341/dsh-scnet" target="_blank" rel="noreferrer">
        <span class="project-kind">原创 · 生态集成</span><h3>dsh-scnet</h3><p>面向 DeepSeek Harness 的 SCNet 知识与工具发布层。</p><b>GitHub ↗</b>
      </a>
      <a class="project-link collaboration-link" href="https://github.com/eric2003/OneFLOW" target="_blank" rel="noreferrer">
        <span class="project-kind">协作 · 贡献者</span><h3>OneFLOW</h3><p>开源大规模多物理场科学计算与 CFD 项目。</p><b>上游仓库 ↗</b>
      </a>
    </div>
    <a class="all-projects" href="/projects/">查看完整项目档案 <span aria-hidden="true">→</span></a>
  </section>

  <section class="principle">
    <h2>构建<br />测量<br /><span>求证</span></h2>
    <p>每一项结论都对应明确的运行环境、工作负载、测试方法和适用边界。</p>
  </section>

  <section class="contact" aria-labelledby="contact-title">
    <div><small>研究与合作</small><h2 id="contact-title">欢迎交流。</h2></div>
    <a class="email" href="mailto:luqilinheu@gmail.com">luqilinheu@gmail.com ↗</a>
  </section>
</BaseLayout>

<style>
  .minimal-hero { min-height: 540px; display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 64px; align-items: end; padding: 74px 0 54px; }
  .overline { color: var(--accent); font: 700 10px/1.4 monospace; letter-spacing: .18em; text-transform: uppercase; }
  .minimal-hero h1 { max-width: 900px; margin: 20px 0 24px; font-size: clamp(58px, 8vw, 112px); font-weight: 610; line-height: .94; letter-spacing: -.075em; }
  .minimal-hero h1 span { color: var(--muted); }
  .intro { max-width: 620px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.75; }
  .scroll-link { display: inline-flex; gap: 10px; margin-top: 34px; color: var(--text); font-size: 13px; font-weight: 700; text-decoration: none; }
  .scroll-link b { color: var(--accent); font-size: 17px; }
  .profile { align-self: end; padding-bottom: 4px; color: var(--muted); font: 11px/1.8 monospace; letter-spacing: .08em; }
  .profile::before { content: ""; display: block; width: 100%; height: 1px; margin-bottom: 22px; background: var(--line); }
  .profile strong { color: var(--text); font-weight: 600; }
  .signal-line { grid-column: 1 / -1; height: 1px; margin-top: 30px; background: linear-gradient(90deg, var(--accent), rgba(155,234,52,.1) 54%, transparent); box-shadow: -40px 0 38px rgba(155,234,52,.22); }

  .work { padding: 82px 0 96px; }
  .work-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 30px; }
  .work-head h2 { margin: 10px 0 0; font-size: clamp(36px, 4vw, 54px); font-weight: 600; letter-spacing: -.055em; }
  .work-head > span { color: #5b645d; font: 10px/1.4 monospace; letter-spacing: .12em; }
  .index { border-top: 1px solid var(--line); }
  .work-row { display: grid; grid-template-columns: 42px minmax(0, 1fr) 210px 30px; gap: 22px; align-items: center; min-height: 0; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding .25s ease, color .25s ease; }
  .work-row:hover { padding-left: 14px; color: var(--accent); }
  .number { align-self: start; padding-top: 10px; color: #5b645d; font: 11px/1 monospace; }
  .work-title h3 { margin: 0; max-width: 760px; font-size: clamp(22px, 2.45vw, 34px); font-weight: 560; line-height: 1.18; letter-spacing: -.045em; }
  .work-title p { margin: 9px 0 0; color: var(--muted); font-size: 13px; }
  .result { color: var(--muted); }
  .result strong { display: block; margin-bottom: 6px; color: var(--text); font-size: 23px; font-weight: 600; letter-spacing: -.045em; }
  .result span { font: 10px/1.5 monospace; letter-spacing: .06em; }
  .arrow { color: var(--accent); font-size: 24px; }

  .open-source { padding: 92px 0 104px; border-top: 1px solid var(--line); }
  .open-source-head { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 70px; align-items: end; margin-bottom: 46px; }
  .open-source-head h2 { margin: 12px 0 0; font-size: clamp(42px, 6vw, 76px); font-weight: 600; line-height: 1.08; letter-spacing: -.06em; }
  .open-source-head > p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .project-links { display: grid; grid-template-columns: 1.15fr 1fr 1fr; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .project-link { min-height: 300px; display: flex; flex-direction: column; padding: clamp(26px, 3.5vw, 42px); text-decoration: none; background: rgba(10,13,10,.72); transition: background .2s ease; }
  .project-link + .project-link { border-left: 1px solid var(--line); }
  .project-link:hover { background: rgba(155,234,52,.045); }
  .project-primary { background: linear-gradient(145deg, rgba(22,31,17,.96), rgba(10,13,10,.8)); }
  .project-kind { color: var(--accent); font: 700 10px/1.4 monospace; letter-spacing: .12em; }
  .project-link h3 { margin: 32px 0 14px; font-size: clamp(28px, 3.4vw, 43px); letter-spacing: -.05em; }
  .project-link p { margin: 0 0 28px; color: var(--muted); line-height: 1.8; }
  .project-link b { margin-top: auto; color: var(--text); font-size: 12px; }
  .collaboration-link .project-kind { color: var(--muted); }
  .all-projects { display: flex; justify-content: space-between; gap: 20px; margin-top: 22px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; font-weight: 700; text-decoration: none; }
  .all-projects span { color: var(--accent); font-size: 18px; }

  .principle { display: grid; grid-template-columns: minmax(0, 1fr) 270px; gap: 70px; align-items: end; padding: 86px 0; border-top: 1px solid var(--line); }
  .principle h2 { max-width: 970px; margin: 0; font-size: clamp(50px, 8vw, 112px); font-weight: 590; line-height: 1.06; letter-spacing: -.07em; }
  .principle h2 span { color: var(--accent); }
  .principle p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.8; }

  .contact { position: relative; left: 50%; width: 100vw; margin-left: -50vw; display: flex; align-items: center; justify-content: space-between; gap: 50px; padding: 62px max(28px, calc((100vw - var(--max)) / 2)); color: #0a0d08; background: var(--accent); }
  .contact small { display: block; margin-bottom: 10px; font: 800 10px/1.4 monospace; letter-spacing: .16em; }
  .contact h2 { margin: 0; font-size: clamp(38px, 6vw, 76px); font-weight: 650; line-height: 1; letter-spacing: -.06em; }
  .email { padding-bottom: 5px; border-bottom: 1px solid rgba(10,13,8,.45); font-size: clamp(16px, 2vw, 22px); font-weight: 680; text-decoration: none; white-space: nowrap; }

  @media (max-width: 820px) {
    .minimal-hero { grid-template-columns: 1fr; gap: 55px; align-items: end; }
    .profile { max-width: 360px; }
    .signal-line { grid-column: 1; }
    .work-row { grid-template-columns: 38px minmax(0, 1fr) 30px; }
    .result { grid-column: 2; }
    .arrow { grid-column: 3; grid-row: 1 / 3; }
    .principle { grid-template-columns: 1fr; }
    .principle p { max-width: 500px; }
    .open-source-head { grid-template-columns: 1fr; gap: 28px; }
    .project-links { grid-template-columns: 1fr; }
    .project-link + .project-link { border-left: 0; border-top: 1px solid var(--line); }
    .project-link { min-height: 250px; }
    .contact { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 580px) {
    .minimal-hero { min-height: 650px; padding: 60px 0 42px; }
    .minimal-hero h1 { font-size: clamp(58px, 19vw, 92px); }
    .intro { font-size: 16px; }
    .work { padding: 70px 0 90px; }
    .work-head { align-items: flex-start; flex-direction: column; }
    .work-row { min-height: 0; gap: 15px; padding: 22px 0; }
    .work-title h3 { font-size: 29px; }
    .principle { padding: 82px 0; }
    .open-source { padding: 76px 0 88px; }
    .contact { padding-top: 70px; padding-bottom: 70px; }
    .email { white-space: normal; word-break: break-word; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row { transition: none; }
  }
</style>
