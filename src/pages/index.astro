---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportCard from '../components/ReportCard.astro';
const reports = (await getCollection('reports')).filter((item) => item.data.featured).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="opensource_community · HPC & GPU Engineering" description="Open-source engineering, GPU software adaptation, and reproducible performance studies.">
  <section class="hero">
    <div class="eyebrow">HPC · GPU Software · Open Source</div>
    <h1>Engineering open-source workloads for heterogeneous computing.</h1>
    <p class="lead">A growing portfolio of GPU software adaptation, performance analysis, and reproducible engineering practice. Personal profile and career details will be added in the next content pass.</p>
    <div class="actions"><a class="button primary" href="/projects/">View projects</a><a class="button" href="/reports/">Read reports</a></div>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Selected work</div><h2>Engineering reports</h2></div><p>Technical evidence with explicit environments, methods, results, and limitations.</p></div>
    <div class="grid">{reports.map(({ data }) => <ReportCard {...data} />)}</div>
  </section>
</BaseLayout>
